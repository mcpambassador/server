      "id": "number-unsafe-int-same",
      "note": "9007199254740992 (same hash as the case above)",
      "canonical": "{\"inputSchema\":{\"maximum\":9007199254740992,\"type\":\"object\"},\"name\":\"n\"}",
      "sha256": "329537cca38067aabe1cd69c43465cba9cf03a7ff778f230d095e849eba7ffdb",
