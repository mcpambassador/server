  "size": {
    "note": "canonical size cap is measured in UTF-8 BYTES of the canonical form (not characters)",
    "maxCanonicalBytes": 65536,
    "behavior": "canonical bytes > cap => pending_review with flag canonical_too_large; never auto-approved, even under pin_policy=auto. Exactly cap is accepted.",
    "cases": [
      {
        "id": "size-exact",
        "note": "canonical form is exactly 65536 bytes: accepted",
        "description_repeat": {
          "char": "a",
          "count": 65381
        },
        "expected_canonical_bytes": 65536,
        "description_chars": 65381,
        "expected": "ok"
      },
      {
        "id": "size-over-by-one",
        "note": "65537 bytes: canonical_too_large",
        "description_repeat": {
          "char": "a",
          "count": 65382
        },
        "expected_canonical_bytes": 65537,
        "description_chars": 65382,
        "expected": "canonical_too_large"
      },
      {
        "id": "size-multibyte-over",
        "note": "fewer characters than the cap but more UTF-8 bytes: canonical_too_large",
        "description_repeat": {
          "char": "é",
          "count": 32691
        },
        "expected_canonical_bytes": 65537,
        "description_chars": 32691,
        "expected": "canonical_too_large"
      }
    ]
  }
