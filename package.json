{
  "name": "@mcpambassador/monorepo",
  "version": "0.10.4",
  "private": true,
  "description": "MCP Ambassador Server - Monorepo Root",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcpambassador/server.git"
  },
  "homepage": "https://github.com/mcpambassador/server#readme",
  "bugs": {
    "url": "https://github.com/mcpambassador/server/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:logger": "node scripts/check-logger-calls.mjs",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:generate": "cd packages/core && drizzle-kit generate",
    "db:push": "cd packages/core && drizzle-kit push",
    "db:studio": "cd packages/core && drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild",
      "re2"
    ],
    "overrides": {
      "hono": "^4.12.25",
      "@hono/node-server": "^2.1.3",
      "@fastify/static>glob": "^14.0.3",
      "glob@14>minimatch": "^11.0.2",
      "rollup": "^4.59.0",
      "picomatch": "^4.0.4",
      "undici": "^7.24.0",
      "flatted": "^3.4.2",
      "tar": "^7.5.19",
      "minimatch": "^9.0.7",
      "fast-uri": "^3.1.7",
      "brace-expansion": "^2.1.6",
      "ip-address": "^10.3.1",
      "find-my-way": "^9.7.0",
      "vite": ">=6.4.4 <7"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
