{
  "name": "@mcpambassador/monorepo",
  "version": "0.9.1",
  "private": true,
  "description": "MCP Ambassador Server - Monorepo Root",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcpambassador/server.git"
  },
  "homepage": "https://github.com/mcpambassador/server#readme",
  "bugs": {
    "url": "https://github.com/mcpambassador/server/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:logger": "node scripts/check-logger-calls.mjs",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,json,md}\"",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "db:generate": "cd packages/core && drizzle-kit generate:sqlite",
    "db:push": "cd packages/core && drizzle-kit push:sqlite",
    "db:studio": "cd packages/core && drizzle-kit studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.5",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^1.2.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "pnpm": {
    "overrides": {
      "hono": "^4.12.25",
      "@hono/node-server": "^1.19.10",
      "rollup": "^4.59.0",
      "picomatch": "^4.0.4",
      "undici": "^7.24.0",
      "flatted": "^3.4.2",
      "tar": "^7.5.19",
      "minimatch": "^9.0.7",
      "fast-uri": "^3.1.7",
      "brace-expansion": "^2.1.6",
      "ip-address": "^10.3.1",
      "find-my-way": "^9.7.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-gpj5-g38j-94v9"
      ]
    }
  }
}
